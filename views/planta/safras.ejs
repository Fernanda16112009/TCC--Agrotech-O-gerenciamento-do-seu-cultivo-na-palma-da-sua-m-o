<%- include('../partials/cabecalho', { titulo: titulo, estilos: estilos }) %>
<body>
    <main>
        <div class="plantas-container">
            <h1 class="titulo-pagina">Meus tipos de <%= nomeTipoPlanta %></h1>

            <div class="plantas-grid">
                <% safras.forEach(function (s) { %>
                <form action="<%= s.url %>" method="get" required>
                    <button class="card-planta">
                        <img src="<%= s.imagem %>" alt="<%= nomeTipoPlanta %>" class="card-icon">
                        <span class="card-titulo"><%= s.nome %></span>
                        <span class="card-subtitulo">Ver detalhes</span>
                    </button>
                </form>
                <% }) %>
            </div>

            <%- include('../partials/botaoVoltar', { destino: '/planta/minhasPlantas', classe: '' }) %>
        </div>
    </main>

    <%- include('../partials/rodape') %>
</body>
</html>